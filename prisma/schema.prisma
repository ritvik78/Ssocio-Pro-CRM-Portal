generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Submission {
  id        Int      @id @default(autoincrement())
  audience  String
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")

  @@index([audience, createdAt])
  @@map("submissions")
}
